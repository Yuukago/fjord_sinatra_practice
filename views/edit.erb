<p>変更したい内容を入力してください</p>

<div class="form-box">
  <form action="/<%= @display_memo["id"] %>/edit" method="post">
    <input type="hidden" name="_method" value="patch">
    <label for="title" class="invisible-label">
      <input type="text" name="title" value="<%= @display_memo["title"] %>">
    </label>
    <label for="message" class="invisible-label">
      <textarea name="message" rows="15" cols="20"><%= @display_memo["message"] %></textarea>
    </label>

    <input type="submit" value="修正する" class="all-button">
  </form>

  <input type="button" onclick="location.href='/<%= @display_memo["id"] %>'" value="戻る" class="return-button">
</div>
